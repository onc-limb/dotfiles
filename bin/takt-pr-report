#!/usr/bin/env python3
"""Copy each TAKT task's final summary (summary.md) into its pull request body.

TAKT 0.75 writes only "Workflow `<name>` completed successfully." as the
report in the PR body it creates. The final gate's summary.md (which, with
the agora-peer-review workflow, ends with the order's final report) stays in
the run's reports directory, where nobody reading the PR sees it. This script
puts it into the PR body.

    takt-pr-report [project dir] [--dry-run]

For every task in <project>/.takt/tasks.yaml that is completed and has a
pr_url, it finds the newest summary.md under
<worktree_path>/.takt/runs/<run_slug>/reports/ and, when the PR is open and
its body has no marker yet, inserts the summary (before TAKT's managed
marker, so TAKT still treats the body as its own). Running it again changes
nothing. bin/takt runs it after `takt run` / `takt watch`; it can also be run
by hand for runs that finished before.

Local paths are not written to the PR: the worktree path is cut off and the
home directory becomes ~.
"""
import json
import subprocess
import sys
from pathlib import Path

import yaml

MARKER = "<!-- takt:final-report -->"
TAKT_MARKER = "<!-- takt:managed -->"
HEADING = "## TAKT の最終確認（summary.md）"
# GitHub rejects bodies over 65,536 characters.
BODY_LIMIT = 60000


def log(message: str) -> None:
    print(f"takt-pr-report: {message}", file=sys.stderr)


def newest_summary(reports: Path) -> Path | None:
    candidates = [
        p for p in reports.rglob("summary.md") if ".takt-report-internal" not in p.parts
    ]
    return max(candidates, key=lambda p: p.stat().st_mtime, default=None)


def scrub(text: str, worktree: str) -> str:
    text = text.replace(worktree.rstrip("/") + "/", "")
    return text.replace(str(Path.home()), "~")


def build_body(body: str, summary: str) -> str:
    section = f"{MARKER}\n{HEADING}\n\n{summary.strip()}\n"
    base = body.rstrip()
    managed = base.endswith(TAKT_MARKER)
    if managed:
        base = base[: -len(TAKT_MARKER)].rstrip()
    room = BODY_LIMIT - len(base) - len(TAKT_MARKER) - 8
    if len(section) > room:
        note = "\n\n（長すぎるため、ここで切りました。全文は run の reports/ の summary.md）\n"
        section = section[: max(room - len(note), 0)] + note
    parts = [base, section.rstrip()]
    if managed:
        parts.append(TAKT_MARKER)
    return "\n\n".join(p for p in parts if p) + "\n"


def gh(*args: str, stdin: str | None = None) -> str:
    return subprocess.run(
        ["gh", *args], input=stdin, capture_output=True, text=True, check=True
    ).stdout


def main(argv: list[str]) -> int:
    dry_run = "--dry-run" in argv
    rest = [a for a in argv if a != "--dry-run"]
    project = Path(rest[0] if rest else ".").resolve()
    tasks_file = project / ".takt" / "tasks.yaml"
    if not tasks_file.is_file():
        return 0
    tasks = (yaml.safe_load(tasks_file.read_text(encoding="utf-8")) or {}).get("tasks") or []
    failed = False
    for task in tasks:
        url, worktree, slug = task.get("pr_url"), task.get("worktree_path"), task.get("run_slug")
        if task.get("status") != "completed" or not (url and worktree and slug):
            continue
        reports = Path(worktree) / ".takt" / "runs" / slug / "reports"
        summary = newest_summary(reports) if reports.is_dir() else None
        if summary is None:
            continue
        try:
            pr = json.loads(gh("pr", "view", url, "--json", "state,body"))
        except (subprocess.CalledProcessError, FileNotFoundError, json.JSONDecodeError) as e:
            log(f"{url}: could not read the PR ({e})")
            failed = True
            continue
        body = pr.get("body") or ""
        if pr.get("state") != "OPEN" or MARKER in body:
            continue
        new_body = build_body(body, scrub(summary.read_text(encoding="utf-8"), worktree))
        if dry_run:
            print(f"--- {url}\n{new_body}")
            continue
        try:
            gh("pr", "edit", url, "--body-file", "-", stdin=new_body)
        except (subprocess.CalledProcessError, FileNotFoundError) as e:
            log(f"{url}: could not edit the PR ({e})")
            failed = True
            continue
        log(f"{url}: added the final summary ({task.get('name')})")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
