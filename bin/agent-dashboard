#!/usr/bin/env python3
"""The dashboard tab: work environments (tabs) of the current WezTerm workspace and their agents.

    workspace
      └ work environment (= tab, one directory / worktree)   -> a card
          └ agent (= pane running Claude Code / Codex)        -> a row in the card

With --sidebar it is the narrow column on the right of a work environment instead: one card per agent
of that tab (state, what it was asked, what it is doing now), split evenly over the height.
It exits once the tab has no agents, which closes the column.

Agents wait in a hidden workspace and are moved into their tab only while shown (bin/agent-view);
an agent belongs to the tab that holds its home pane (the "home" field of its state file).
Joins `wezterm cli list` with the per-pane state files written by bin/agent-state.
Colors come from wezterm/palette.lua so the dashboard matches WezTerm and nvim.
The background is left unpainted so the WezTerm background shows through.

Keys / mouse:
  j/k ↓/↑  move between rows      h/l ←/→ Tab  move between cards
  Enter    open the selection      click        open what was clicked
  1-9      jump to agent           a            toggle cards / flat agent list (waiting first)
"""
import contextlib
import json
import os
import re
import select
import shutil
import subprocess
import sys
import termios
import time
import tty
import unicodedata
from urllib.parse import unquote, urlparse

STATE_DIR = os.path.expanduser("~/.local/state/agents")
HOME = os.path.expanduser("~")
PALETTE_FILE = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "wezterm", "palette.lua")
DASHBOARD_TITLE = "◆ agents"
ORDER = {"waiting": 0, "working": 1, "done": 2, "idle": 3}
STATE_LABEL = {"waiting": "入力待ち", "working": "作業中", "done": "完了", "idle": "待機"}
TOOL_LABEL = {"claude": "Claude", "codex": "Codex"}
WEEKDAY = ["月", "火", "水", "木", "金", "土", "日"]
REFRESH_SEC = 2
BRANCH_TTL_SEC = 10
CARD_MIN_W = 48
CARD_MAX_W = 72
GAP = 2
MARGIN = 2


# ---------------------------------------------------------------- colors


MODE_FILE = os.path.expanduser("~/.local/state/wezterm/theme")
DEFAULT_COLORS = {
    "light": {"fg": "#1F1F1F", "muted": "#6E6E6E", "accent": "#005FB8", "accent_fg": "#FFFFFF", "surface": "#E6E6E6",
              "selection": "#ADD6FF", "ok": "#0B7A0B", "warn": "#9A6700", "error": "#B3261E"},
    "dark": {"fg": "#E4E4E4", "muted": "#9A9DA6", "accent": "#4C9BF0", "accent_fg": "#0E1620", "surface": "#3A3D45",
             "selection": "#264F78", "ok": "#5BC46A", "warn": "#E2B341", "error": "#F0605A"},
}


def current_mode():
    """light / dark, the same file WezTerm and nvim read (LEADER+b switches it)."""
    try:
        with open(MODE_FILE) as f:
            return "dark" if f.read().strip() == "dark" else "light"
    except OSError:
        return "light"


def load_palette(mode):
    """The colors of one mode: the "#RRGGBB" values inside `M.<mode> = { ... }` of palette.lua."""
    colors = dict(DEFAULT_COLORS[mode])
    try:
        with open(PALETTE_FILE) as f:
            text = f.read()
        m = re.search(rf"^M\.{mode} = \{{(.*?)^\}}", text, re.M | re.S)
        seen = set()
        for key, value in re.findall(r'^\s*(\w+)\s*=\s*"(#[0-9A-Fa-f]{6})"', m[1] if m else "", re.M):
            if key in colors and key not in seen:
                colors[key] = value
                seen.add(key)
    except OSError:
        pass
    return colors


PAL = {}
STATE_COLOR = {}
_mode = None


def refresh_palette():
    """Follow LEADER+b: reload the colors when the mode changed (PAL / STATE_COLOR are updated in place)."""
    global _mode
    mode = current_mode()
    if mode == _mode:
        return
    _mode = mode
    PAL.update(load_palette(mode))
    STATE_COLOR.update({"waiting": PAL["warn"], "working": PAL["accent"], "done": PAL["ok"], "idle": PAL["muted"]})


refresh_palette()
RESET = "\033[0m"


def rgb(hex_):
    return int(hex_[1:3], 16), int(hex_[3:5], 16), int(hex_[5:7], 16)


def style(fg=None, bg=None, bold=False):
    s = ""
    if bold:
        s += "\033[1m"
    if fg:
        s += "\033[38;2;%d;%d;%dm" % rgb(fg)
    if bg:
        s += "\033[48;2;%d;%d;%dm" % rgb(bg)
    return s


# ---------------------------------------------------------------- text width


def cwidth(c):
    if unicodedata.combining(c):
        return 0
    return 2 if unicodedata.east_asian_width(c) in "WF" else 1


def width(s):
    return sum(cwidth(c) for c in s)


def fit(s, n, align="left"):
    """Truncate (with …) / pad to exactly n display columns."""
    if n <= 0:
        return ""
    if width(s) > n:
        out, w = "", 0
        for c in s:
            if w + cwidth(c) > n - 1:
                break
            out, w = out + c, w + cwidth(c)
        s = out + "…"
    pad = " " * (n - width(s))
    return pad + s if align == "right" else s + pad


class Line:
    """A line made of styled segments, with a known display width."""

    def __init__(self):
        self.parts, self.w = [], 0

    def add(self, text, fg=None, bg=None, bold=False):
        self.parts.append((text, fg, bg, bold))
        self.w += width(text)
        return self

    def pad_to(self, n, bg=None):
        if self.w < n:
            self.add(" " * (n - self.w), bg=bg)
        return self

    def render(self):
        return "".join(style(fg, bg, bold) + text + RESET for text, fg, bg, bold in self.parts)


# ---------------------------------------------------------------- data


def wezterm_panes():
    try:
        out = subprocess.run(
            ["wezterm", "cli", "list", "--format", "json"], capture_output=True, text=True, timeout=5
        ).stdout
        return json.loads(out)
    except (OSError, ValueError, subprocess.SubprocessError):
        return []


def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def pane_path(pane):
    url = pane.get("cwd") or ""
    return unquote(urlparse(url).path) if url.startswith("file://") else url


def short_path(path):
    path = path.rstrip("/") or "/"
    return "~" + path[len(HOME):] if path == HOME or path.startswith(HOME + "/") else path


_branch_cache = {}


def git_info(path):
    """(repo, branch) for a directory, or None outside git. In a worktree, repo is the original repository."""
    hit = _branch_cache.get(path)
    if hit and time.time() - hit[1] < BRANCH_TTL_SEC:
        return hit[0]
    info = None
    try:
        out = subprocess.run(
            ["git", "-C", path, "rev-parse", "--path-format=absolute", "--git-common-dir", "--abbrev-ref", "HEAD"],
            capture_output=True, text=True, timeout=2,
        ).stdout.split("\n")
        if len(out) >= 2 and out[0]:
            info = (os.path.basename(os.path.dirname(out[0].rstrip("/"))), out[1])
    except (OSError, subprocess.SubprocessError):
        pass
    _branch_cache[path] = (info, time.time())
    return info


def agent_states():
    """pane id -> state of the agent running in that pane."""
    states = {}
    try:
        names = os.listdir(STATE_DIR)
    except OSError:
        return states
    for name in names:
        m = re.fullmatch(r"(\d+)\.json", name)
        if m:
            state = read_json(os.path.join(STATE_DIR, name))
            if state:
                states[int(m[1])] = state
    return states


def tab_agents(tab_pane_ids, states, all_panes):
    """Agents of a tab, in launch order: [(pane, state)]. An agent belongs to the tab that holds its home
    pane, wherever the agent pane is now (hidden workspace, or the tab while shown)."""
    out = []
    for pane_id, state in states.items():
        home = state.get("home")
        if pane_id in all_panes and (home in tab_pane_ids if home is not None else pane_id in tab_pane_ids):
            out.append((all_panes[pane_id], state))
    out.sort(key=lambda r: r[0]["pane_id"])
    return out


def collect():
    """Returns (workspace, envs). envs keep the tab order; each env has its agents in screen order."""
    panes = wezterm_panes()
    all_panes = {p["pane_id"]: p for p in panes}
    states = agent_states()
    me = os.environ.get("WEZTERM_PANE")
    mine = next((p for p in panes if str(p["pane_id"]) == me), None)
    workspace = mine["workspace"] if mine else None
    envs, by_tab = [], {}
    for p in panes:
        if workspace and p["workspace"] != workspace:
            continue
        env = by_tab.get(p["tab_id"])
        if env is None:
            title = p.get("tab_title") or ""
            env = {"tab_id": p["tab_id"], "panes": [], "agents": [], "title": title}
            env["is_dashboard"] = bool(mine and p["tab_id"] == mine["tab_id"]) or title == DASHBOARD_TITLE
            by_tab[p["tab_id"]] = env
            envs.append(env)
        # An agent shown in its tab is not part of the environment's own layout
        # (one run directly in a pane, without a home, is)
        if (states.get(p["pane_id"]) or {}).get("home") is None:
            env["panes"].append(p)
    envs = [e for e in envs if e["panes"]]
    for env in envs:
        env["agents"] = tab_agents({p["pane_id"] for p in env["panes"]}, states, all_panes)
        env["panes"].sort(key=lambda p: (p["left_col"], p["top_row"], p["pane_id"]))
        # The main pane (nvim) is the top-left one; its directory names the environment
        env["main_pane"] = env["panes"][0]
        env["path"] = pane_path(env["main_pane"])
        # Same name as the WezTerm tab: "<repo>  <branch>" (worktrees show the original repository's name)
        git = None if env["is_dashboard"] else git_info(env["path"])
        env["name"] = git[0] if git else (env["title"] or os.path.basename(env["path"].rstrip("/")) or env["path"])
        env["branch"] = git[1] if git else ""
    # The dashboard tab itself goes last, and only when meta agents run in it
    envs = [e for e in envs if not e["is_dashboard"]] + [e for e in envs if e["is_dashboard"] and e["agents"]]
    return workspace, envs


def quotas():
    rows = []
    try:
        names = sorted(os.listdir(STATE_DIR))
    except OSError:
        return rows
    for name in names:
        if name.startswith("quota-") and name.endswith(".json"):
            data = read_json(os.path.join(STATE_DIR, name))
            if data and isinstance(data.get("windows"), dict):
                rows.append(data)
    return rows


# ---------------------------------------------------------------- formatting


def reset_text(key, ts):
    t = time.localtime(ts)
    if key == "5h":
        return time.strftime("%H:%M", t)
    return f"{t.tm_mon}/{t.tm_mday}({WEEKDAY[t.tm_wday]}) {time.strftime('%H:%M', t)}"


def until(ts):
    sec = int(ts - time.time())
    if sec <= 0:
        return ""
    if sec < 3600:
        return f"あと{sec // 60}分"
    if sec < 86400:
        return f"あと{sec // 3600}時間{sec % 3600 // 60}分"
    return f"あと{sec // 86400}日{sec % 86400 // 3600}時間"


def age(ts):
    if not ts:
        return ""
    sec = int(time.time() - ts)
    if sec < 60:
        return f"{sec}秒前"
    if sec < 3600:
        return f"{sec // 60}分前"
    return f"{sec // 3600}時間前"


def pct_color(pct):
    return PAL["error"] if pct >= 80 else PAL["warn"] if pct >= 60 else PAL["accent"]


def env_state(env):
    states = [s.get("state") for _, s in env["agents"]]
    return min(states, key=lambda s: ORDER.get(s, 9)) if states else None


# ---------------------------------------------------------------- widgets


def card(w, title_line, body, selected=False):
    """A rounded card of width w. title_line / body are Line objects (inner width w-4)."""
    border = PAL["accent"] if selected else PAL["muted"]
    inner = w - 4
    out = []
    top = Line().add("╭─ ", fg=border)
    for text, fg, bg, bold in title_line.parts:
        top.add(text, fg, bg, bold)
    top.add(" ", fg=border)
    top.add("─" * max(0, w - 1 - top.w), fg=border).add("╮", fg=border)
    out.append(top)
    for line in body:
        row = Line().add("│ ", fg=border)
        for text, fg, bg, bold in line.parts:
            row.add(text, fg, bg, bold)
        row.pad_to(inner + 2, bg=line.parts[-1][2] if line.parts and getattr(line, "fill", False) else None)
        row.add(" │", fg=border)
        out.append(row)
    out.append(Line().add("╰" + "─" * (w - 2) + "╯", fg=border))
    return out


def meter(pct, n):
    filled = max(0, min(n, round(pct / 100 * n)))
    return Line().add("━" * filled, fg=pct_color(pct)).add("─" * (n - filled), fg=PAL["surface"])


def quota_card(q, w):
    tool = TOOL_LABEL.get(q.get("tool"), q.get("tool", "?"))
    title = Line().add(tool, fg=PAL["fg"], bold=True).add(f"  {q.get('profile', '')}", fg=PAL["muted"])
    inner = w - 4
    body = []
    now = time.time()
    for key, label in (("5h", "5時間"), ("week", "週間")):
        win = q["windows"].get(key)
        if not win or win.get("pct") is None:
            continue
        resets = win.get("resets_at")
        line = Line().add(fit(label, 6), fg=PAL["muted"])
        if resets and resets < now:
            body.append(line.add("リセット済み", fg=PAL["ok"]))
            body.append(Line())
            continue
        pct = round(win["pct"])
        bar = meter(pct, max(8, inner - 6 - 6))
        for part in bar.parts:
            line.add(*part)
        line.add(fit(f"{pct}%", 6, "right"), fg=pct_color(pct), bold=True)
        body.append(line)
        sub = Line().add(" " * 6)
        if resets:
            sub.add(f"{reset_text(key, resets)}", fg=PAL["fg"]).add(f"   {until(resets)}", fg=PAL["muted"])
        body.append(sub)
    return card(w, title, body)


def agent_line(num, state, inner, selected):
    bg = PAL["selection"] if selected else None
    st = state.get("state")
    ctx = state.get("ctx_pct")
    tail = f"{ctx}%" if ctx is not None else ""
    line = Line()
    line.fill = selected
    line.add(f" {num} ", fg=PAL["accent_fg"] if selected else PAL["muted"], bg=PAL["accent"] if selected else bg, bold=True)
    line.add(" ", bg=bg)
    line.add(fit(TOOL_LABEL.get(state.get("tool"), state.get("tool", "?")), 8), fg=PAL["fg"], bg=bg, bold=True)
    line.add("● ", fg=STATE_COLOR.get(st, PAL["muted"]), bg=bg)
    line.add(fit(STATE_LABEL.get(st, "?"), 10), fg=STATE_COLOR.get(st, PAL["muted"]), bg=bg)
    rest = inner - line.w - 6 - 8
    line.add(fit(state.get("model") or "", max(0, rest)), fg=PAL["muted"], bg=bg)
    line.add(fit(tail, 6, "right"), fg=pct_color(ctx) if ctx is not None else PAL["muted"], bg=bg)
    line.add(fit(age(state.get("updated_at")), 8, "right"), fg=PAL["muted"], bg=bg)
    return line


# ---------------------------------------------------------------- screen


class Screen:
    def __init__(self):
        self.lines = []  # list of Line
        self.hits = []  # (row, col0, col1, item index)

    def blank(self, n=1):
        for _ in range(n):
            self.lines.append(Line())

    def put(self, line):
        self.lines.append(line)

    def put_cards(self, cards, cols, hit_items=None):
        """cards: list of (list[Line], width). Lays them out in rows of `cols` columns."""
        for start in range(0, len(cards), cols):
            row_cards = cards[start:start + cols]
            height = max(len(c[0]) for c in row_cards)
            top = len(self.lines)
            for i in range(height):
                line = Line().add(" " * MARGIN)
                for j, (lines, w) in enumerate(row_cards):
                    if j:
                        line.add(" " * GAP)
                    piece = lines[i] if i < len(lines) else Line().add(" " * w)
                    for part in piece.parts:
                        line.add(*part)
                    line.pad_to(MARGIN + sum(c[1] for c in row_cards[: j + 1]) + GAP * j)
                self.lines.append(line)
            if hit_items:
                col = MARGIN
                for j, (lines, w) in enumerate(row_cards):
                    for offset, item in hit_items[start + j]:
                        self.hits.append((top + offset, col, col + w, item))
                    col += w + GAP

    def draw(self, rows):
        out = ["\033[H"]
        for line in self.lines[:rows]:
            out.append(line.render() + "\033[K\r\n")
        out.append("\033[J")
        sys.stdout.write("".join(out))
        sys.stdout.flush()


def build_items(envs, flat):
    """Selectable items in navigation order: dicts with kind / key / pane / env / state / num."""
    items, num = [], 0
    if flat:
        agents = [(env, p, s) for env in envs for p, s in env["agents"]]
        agents.sort(key=lambda r: (ORDER.get(r[2].get("state"), 9), -(r[2].get("updated_at") or 0)))
        for env, p, s in agents:
            num += 1
            items.append({"kind": "agent", "key": ("p", p["pane_id"]), "pane": p, "env": env, "state": s, "num": num})
        return items
    for env in envs:
        items.append({"kind": "env", "key": ("t", env["tab_id"]), "pane": env["main_pane"], "env": env})
        for p, s in env["agents"]:
            num += 1
            items.append({"kind": "agent", "key": ("p", p["pane_id"]), "pane": p, "env": env, "state": s, "num": num})
    return items


def layout(workspace, envs, items, cursor, flat):
    cols_total, rows_total = shutil.get_terminal_size((120, 40))
    avail = cols_total - MARGIN * 2
    scr = Screen()
    current = items[cursor] if items else None

    # ---- header
    n_envs = sum(1 for e in envs if not e["is_dashboard"])
    all_states = [s.get("state") for e in envs for _, s in e["agents"]]
    scr.blank()
    head = Line().add(" " * MARGIN).add(f"  ◆ {workspace or '?'}  ", fg=PAL["accent_fg"], bg=PAL["accent"], bold=True)
    head.add(f"   作業環境 {n_envs}", fg=PAL["fg"]).add(f"   エージェント {len(all_states)}", fg=PAL["fg"])
    summary = Line()
    for st in ("waiting", "working", "done"):
        summary.add("   ● ", fg=STATE_COLOR[st]).add(f"{STATE_LABEL[st]} {all_states.count(st)}", fg=PAL["fg"])
    clock = f"   {time.strftime('%H:%M:%S')}"
    head.add(" " * max(1, MARGIN + avail - head.w - summary.w - width(clock)))
    for part in summary.parts:
        head.add(*part)
    head.add(clock, fg=PAL["muted"])
    scr.put(head)
    scr.blank()

    # ---- quotas
    qs = quotas()
    if qs:
        scr.put(Line().add(" " * MARGIN).add("利用制限", fg=PAL["muted"], bold=True))
        qcols = max(1, min(len(qs), (avail + GAP) // (CARD_MIN_W + GAP)))
        qw = min(CARD_MAX_W, (avail - GAP * (qcols - 1)) // qcols)
        scr.put_cards([(quota_card(q, qw), qw) for q in qs], qcols)
        scr.blank()

    # ---- environments / agents
    ncols = max(1, (avail + GAP) // (CARD_MIN_W + GAP))
    if flat:
        scr.put(Line().add(" " * MARGIN).add("エージェント  ", fg=PAL["muted"], bold=True).add("入力待ちが先頭", fg=PAL["muted"]))
        w = avail
        body, hit = [], []
        for idx, it in enumerate(items):
            line = agent_line(it["num"], it["state"], w - 4 - 18, idx == cursor)
            line.add(fit("  " + it["env"]["name"], 18), fg=PAL["muted"], bg=PAL["selection"] if idx == cursor else None)
            hit.append((len(body) + 1, idx))
            body.append(line)
        if not body:
            body.append(Line().add("エージェントは動いていません", fg=PAL["muted"]))
        scr.put_cards([(card(w, Line().add("全エージェント", fg=PAL["fg"], bold=True), body, True), w)], 1, [hit])
    else:
        scr.put(Line().add(" " * MARGIN).add("作業環境", fg=PAL["muted"], bold=True))
        ncols = max(1, min(ncols, len(envs) or 1))
        w = min(CARD_MAX_W, (avail - GAP * (ncols - 1)) // ncols)
        cards, hits = [], []
        for env in envs:
            env_items = [(i, it) for i, it in enumerate(items) if it["env"] is env]
            selected = current is not None and current["env"] is env
            st = env_state(env)
            title = Line().add("● ", fg=STATE_COLOR.get(st, PAL["surface"]))
            name = "一覧タブ" if env["is_dashboard"] else env["name"]
            env_selected = selected and current["kind"] == "env"
            title.add(fit(name, w - 12) if width(name) > w - 12 else name, fg=PAL["accent"] if env_selected else PAL["fg"], bold=True)
            if env["branch"]:
                title.add("  \ue725 " + fit(env["branch"], max(1, w - 16 - title.w)) if width(env["branch"]) > w - 16 - title.w else "  \ue725 " + env["branch"], fg=PAL["ok"])
            body = []
            sub = Line().add(short_path(env["path"]), fg=PAL["muted"])
            body.append(sub)
            body.append(Line())
            hit = [(0, env_items[0][0]), (1, env_items[0][0])]
            for i, it in env_items[1:]:
                hit.append((len(body) + 1, i))
                body.append(agent_line(it["num"], it["state"], w - 4, i == cursor))
            if len(env_items) == 1:
                body.append(Line().add("エージェントなし  ", fg=PAL["muted"]).add("LEADER c / x で起動", fg=PAL["muted"]))
            cards.append((card(w, title, body, selected), w))
            hits.append(hit)
        if cards:
            scr.put_cards(cards, ncols, hits)
        else:
            scr.put(Line().add(" " * MARGIN).add("作業環境がありません。Cmd+t か LEADER n で開けます", fg=PAL["muted"]))

    # ---- footer (key hints as pills), pinned to the bottom when there is room
    hints = [("↵", "開く"), ("j k", "移動"), ("h l", "カード"), ("1-9", "エージェントへ"),
             ("a", "カード表示" if flat else "エージェント一覧"), ("クリック", "開く")]
    foot = Line().add(" " * MARGIN)
    for key, label in hints:
        foot.add(f" {key} ", fg=PAL["fg"], bg=PAL["surface"], bold=True).add(f" {label}   ", fg=PAL["muted"])
    while len(scr.lines) < rows_total - 2:
        scr.blank()
    scr.blank()
    scr.put(foot)
    return scr, rows_total


# ---------------------------------------------------------------- input


AGENT_VIEW = os.path.join(os.path.dirname(os.path.realpath(__file__)), "agent-view")


def show_agent(pane_id):
    """Move the agent into its tab and zoom it (bin/agent-view)."""
    subprocess.run([AGENT_VIEW, "show", str(pane_id)], capture_output=True)


def jump(item):
    """Open an item: an agent is shown full size in its tab, an environment is activated."""
    pane = item["pane"]
    if item["kind"] == "agent":
        show_agent(pane["pane_id"])
        return
    subprocess.run(["wezterm", "cli", "activate-tab", "--tab-id", str(pane["tab_id"])], capture_output=True)
    subprocess.run(["wezterm", "cli", "activate-pane", "--pane-id", str(pane["pane_id"])], capture_output=True)


# ---------------------------------------------------------------- sidebar


def wrap(text, n, max_lines):
    """Wrap text to lines of n display columns (the last one ends with … when cut)."""
    lines, cur, w = [], "", 0
    for c in " ".join((text or "").split()):
        if w + cwidth(c) > n:
            lines.append(cur)
            cur, w = "", 0
            if c == " ":
                continue
        cur, w = cur + c, w + cwidth(c)
    if cur:
        lines.append(cur)
    if len(lines) > max_lines:
        lines = lines[:max_lines]
        lines[-1] = fit(lines[-1] + "…", n).rstrip()
    return lines


def sidebar_collect():
    """(agents of this tab [(pane, state)], pane id of the agent shown in the tab or None)."""
    panes = wezterm_panes()
    all_panes = {p["pane_id"]: p for p in panes}
    me = all_panes.get(int(os.environ.get("WEZTERM_PANE") or -1))
    if not me:
        return [], None
    tab_ids = {p["pane_id"] for p in panes if p["tab_id"] == me["tab_id"]}
    # Only agents launched for this tab (with a home); one run directly in a pane is its own pane
    agents = [r for r in tab_agents(tab_ids, agent_states(), all_panes) if r[1].get("home") is not None]
    shown = next((p["pane_id"] for p, _ in agents if p["tab_id"] == me["tab_id"]), None)
    return agents, shown


CIRCLED = "①②③④⑤⑥⑦⑧⑨"


def agent_card(num, state, w, h, selected):
    """One agent: number + tool in the title, then state, what it was asked and what it is doing now."""
    inner = w - 4
    st = state.get("state")
    color = STATE_COLOR.get(st, PAL["muted"])
    title = Line().add(CIRCLED[num - 1] if num <= len(CIRCLED) else str(num), fg=PAL["accent"] if selected else PAL["muted"], bold=True)
    title.add(" " + TOOL_LABEL.get(state.get("tool"), state.get("tool") or "?"), fg=PAL["fg"], bold=True)
    head = Line().add("● ", fg=color).add(STATE_LABEL.get(st, "?"), fg=color, bold=True)
    when = age(state.get("updated_at"))
    head.add(" " * max(1, inner - head.w - width(when))).add(when, fg=PAL["muted"])
    body = [head]
    activity = state.get("activity") or ""
    room = h - 2 - len(body) - (1 if activity else 0)
    task = state.get("task") or ""
    if room > 0:
        for line in wrap(task, inner, room) if task else [("まだ指示はありません", PAL["muted"])][:room]:
            if isinstance(line, tuple):
                body.append(Line().add(line[0], fg=line[1]))
            else:
                body.append(Line().add(line, fg=PAL["fg"]))
    if activity:
        prefix = "許可待ち " if st == "waiting" else "▸ "
        body.append(Line().add(fit(prefix + activity, inner), fg=PAL["warn"] if st == "waiting" else PAL["muted"]))
    while len(body) < h - 2:
        body.append(Line())
    return card(w, title, body[: h - 2], selected)


def sidebar_layout(agents, cursor, shown):
    cols, rows = shutil.get_terminal_size((34, 40))
    scr = Screen()
    w = max(16, cols - 1)
    counts = Line().add(" エージェント", fg=PAL["muted"], bold=True).add(f" {len(agents)}", fg=PAL["fg"], bold=True)
    scr.put(counts)
    foot = Line().add(" ↵/クリック", fg=PAL["fg"], bold=True).add(" 表示  ", fg=PAL["muted"])
    foot.add("LEADER z", fg=PAL["fg"], bold=True).add(" 戻す", fg=PAL["muted"])
    avail = rows - 2
    # Split the height evenly between the cards (at least 5 rows each: border, state, 1 line, border)
    h = max(5, avail // max(1, len(agents)))
    for i, (pane, state) in enumerate(agents):
        top = len(scr.lines)
        selected = pane["pane_id"] == shown or (shown is None and i == cursor)
        for line in agent_card(i + 1, state, w, h, selected):
            scr.put(line)
        for row in range(top, top + h):
            scr.hits.append((row, 0, w, i))
    while len(scr.lines) < rows - 1:
        scr.blank()
    scr.lines = scr.lines[: rows - 1]
    scr.put(foot)
    return scr, rows


def sidebar_main():
    """The agent column of a work environment. Exits when the tab has no agents left."""
    started, empty_since, cursor = time.time(), None, 0
    with terminal():
        while True:
            refresh_palette()
            agents, shown = sidebar_collect()
            if agents:
                empty_since = None
            else:
                empty_since = empty_since or time.time()
                # Give a just launched agent time to appear before closing the column
                if time.time() - empty_since >= 3 and time.time() - started >= 5:
                    return
            cursor = min(cursor, max(0, len(agents) - 1))
            scr, rows = sidebar_layout(agents, cursor, shown)
            scr.draw(rows)
            ready, _, _ = select.select([sys.stdin], [], [], 1)
            if not ready:
                continue
            key = read_input()
            if isinstance(key, tuple):
                _, x, y = key
                for row, c0, c1, idx in scr.hits:
                    if row == y - 1 and c0 <= x - 1 < c1:
                        cursor = idx
                        show_agent(agents[idx][0]["pane_id"])
                        break
            elif key in ("j", "down") and agents:
                cursor = min(cursor + 1, len(agents) - 1)
            elif key in ("k", "up") and agents:
                cursor = max(cursor - 1, 0)
            elif key in ("\r", "\n") and agents:
                show_agent(agents[cursor][0]["pane_id"])
            elif key.isdigit() and key != "0" and int(key) <= len(agents):
                show_agent(agents[int(key) - 1][0]["pane_id"])


# ---------------------------------------------------------------- input


def read_input():
    """Returns a key name, or ("click", x, y) for a left click (SGR mouse, 1-based)."""
    data = os.read(sys.stdin.fileno(), 64).decode(errors="ignore")
    m = re.match(r"\033\[<(\d+);(\d+);(\d+)([Mm])", data)
    if m:
        button, x, y, kind = int(m[1]), int(m[2]), int(m[3]), m[4]
        if button == 0 and kind == "M":
            return ("click", x, y)
        if button in (64, 65):
            return "up" if button == 64 else "down"
        return ""
    keys = {"\033[A": "up", "\033[B": "down", "\033[C": "right", "\033[D": "left", "\t": "right", "\033[Z": "left"}
    return keys.get(data, data[:1])


@contextlib.contextmanager
def terminal():
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    tty.setcbreak(fd)
    # alternate screen, hide cursor, mouse (press + SGR coordinates)
    sys.stdout.write("\033[?1049h\033[?25l\033[?1000h\033[?1006h")
    try:
        yield
    finally:
        sys.stdout.write("\033[?1000l\033[?1006l\033[?25h\033[?1049l")
        sys.stdout.flush()
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def main():
    cursor_key, flat = None, False
    with terminal():
        while True:
            refresh_palette()
            workspace, envs = collect()
            items = build_items(envs, flat)
            keys = [it["key"] for it in items]
            cursor = keys.index(cursor_key) if cursor_key in keys else 0
            scr, rows = layout(workspace, envs, items, cursor, flat)
            scr.draw(rows)
            ready, _, _ = select.select([sys.stdin], [], [], REFRESH_SEC)
            if not ready:
                continue
            key = read_input()
            env_starts = [i for i, it in enumerate(items) if it["kind"] == "env"]
            if isinstance(key, tuple):
                _, x, y = key
                for row, c0, c1, idx in scr.hits:
                    if row == y - 1 and c0 <= x - 1 < c1:
                        cursor = idx
                        jump(items[idx])
                        break
            elif key in ("j", "down") and items:
                cursor = min(cursor + 1, len(items) - 1)
            elif key in ("k", "up") and items:
                cursor = max(cursor - 1, 0)
            elif key in ("l", "right") and env_starts:
                cursor = next((i for i in env_starts if i > cursor), env_starts[0])
            elif key in ("h", "left") and env_starts:
                start = max(i for i in env_starts if i <= cursor)
                prev = [i for i in env_starts if i < start]
                cursor = prev[-1] if prev else env_starts[-1]
            elif key in ("\r", "\n") and items:
                jump(items[cursor])
            elif key == "a":
                flat, cursor = not flat, 0
                cursor_key = None
                continue
            elif key.isdigit() and key != "0":
                agents = [it for it in items if it["kind"] == "agent"]
                if int(key) <= len(agents):
                    jump(agents[int(key) - 1])
            cursor_key = keys[cursor] if items and cursor < len(keys) else None


if __name__ == "__main__":
    try:
        sidebar_main() if "--sidebar" in sys.argv[1:] else main()
    except KeyboardInterrupt:
        pass
