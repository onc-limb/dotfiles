#!/usr/bin/env python3
"""The dashboard tab: work environments (tabs) of the current WezTerm workspace and their agents.

    workspace
      └ work environment (= tab, one directory / worktree)   -> a card
          └ agent (= pane running Claude Code / Codex)        -> a row in the card

Each work environment shows one agent in its right pane; the others wait in a hidden workspace and are
swapped in when shown (bin/agent-view);
an agent belongs to the tab that holds its home pane (the "home" field of its state file).
Joins `wezterm cli list` with the per-pane state files written by bin/agent-state.
Colors come from wezterm/palette.lua (via palette.json) so the dashboard matches WezTerm and nvim.
The background is left unpainted, so it is the pane's (palette.bg).

Keys / mouse:
  j/k ↓/↑  move between rows      h/l ←/→ Tab  move between cards
  Enter    open the selection      click        open what was clicked
  1-9      jump to agent           a            toggle cards / flat agent list (waiting first)
"""
import contextlib
import json
import os
import re
import select
import shutil
import subprocess
import sys
import termios
import time
import tty
import unicodedata
from urllib.parse import unquote, urlparse

STATE_DIR = os.path.expanduser("~/.local/state/agents")
HOME = os.path.expanduser("~")
DASHBOARD_TITLE = "◆ agents"
# wezterm/tabs.lua appends the most urgent agent state to the tab title; drop it to get the tab's name
TAB_STATE_SUFFIX = re.compile(r"\s+[💬⏳✅]$")
ORDER = {"waiting": 0, "working": 1, "done": 2, "idle": 3}
STATE_LABEL = {"waiting": "入力待ち", "working": "作業中", "done": "完了", "idle": "待機"}
TOOL_LABEL = {"claude": "Claude", "codex": "Codex"}
WEEKDAY = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
REFRESH_SEC = 2
BRANCH_TTL_SEC = 10
CARD_MIN_W = 48
CARD_MAX_W = 72
GAP = 2
MARGIN = 2


# ---------------------------------------------------------------- colors


# Written by wezterm/theme.lua each time WezTerm loads its config (scheme picker / light-dark toggle)
PALETTE_JSON = os.path.expanduser("~/.local/state/wezterm/palette.json")
DEFAULT_COLORS = {
    "bg": "#EEEEEA", "card": "#FAFAF7", "fg": "#141414", "muted": "#6A6A64", "accent": "#FF4F00",
    "accent_fg": "#FFFFFF", "accent_text": "#D94300", "surface": "#DEDEDC", "selection": "#FFD8C2",
    "ok": "#2D7A3E", "warn": "#B87400", "error": "#D62A1E", "mode": "light",
    # Decoration colors, used only by the dashboard tab (the agent column stays plain):
    # decoN is a pale fill, inkN the strong color of the same hue for text on it
    "deco1": "#DFA0BF", "deco2": "#E4A1AF", "deco3": "#E9B7A0", "deco4": "#D6C2A0", "deco5": "#A1C2BF",
    "deco6": "#A0C3D1", "deco7": "#B0B3E6",
    "ink1": "#6D153C", "ink2": "#741625", "ink3": "#7C3610", "ink4": "#604610", "ink5": "#15463D",
    "ink6": "#134756", "ink7": "#2A3174",
}
PAL = dict(DEFAULT_COLORS)
STATE_COLOR = {}
_palette_mtime = None


def refresh_palette():
    """Follow LEADER+b / LEADER+Shift+b: reload the colors when palette.json changed (updated in place)."""
    global _palette_mtime
    try:
        mtime = os.path.getmtime(PALETTE_JSON)
    except OSError:
        mtime = None
    if _palette_mtime is not None and mtime == _palette_mtime:
        return
    _palette_mtime = mtime
    data = read_json(PALETTE_JSON) or {}
    PAL.clear()
    PAL.update(DEFAULT_COLORS)
    PAL.update({k: v for k, v in data.items() if k in DEFAULT_COLORS and isinstance(v, str)})
    STATE_COLOR.update({"waiting": PAL["warn"], "working": PAL["accent_text"], "done": PAL["ok"], "idle": PAL["muted"]})


RESET = "\033[0m"


def deco(i):
    """The i-th decoration fill, a pale color (cycles through the scheme's hues)."""
    return PAL[f"deco{i % 7 + 1}"]


def ink(i):
    """Text color for deco(i): the strong color of the same hue (never dark text on a dark fill)."""
    return PAL[f"ink{i % 7 + 1}"]


def tint(color):
    """A pale fill of color, for chips (same mix as palette.lua)."""
    return mix(color, PAL["bg"], 0.6 if PAL.get("mode") == "dark" else 0.65)


def ink_of(color):
    """Text color for a chip on tint(color) (same mix as palette.lua)."""
    return mix(color, PAL["fg"], 0.35 if PAL.get("mode") == "dark" else 0.5)


def mix(a, b, t):
    ra, ga, ba = rgb(a)
    rb, gb, bb = rgb(b)
    return "#%02X%02X%02X" % (round(ra + (rb - ra) * t), round(ga + (gb - ga) * t), round(ba + (bb - ba) * t))


def gradient(t):
    """A color along all decoration hues, t in 0..1."""
    stops = [PAL[f"deco{i}"] for i in range(1, 8)]
    x = max(0.0, min(1.0, t)) * (len(stops) - 1)
    i = min(int(x), len(stops) - 2)
    return mix(stops[i], stops[i + 1], x - i)


def rgb(hex_):
    return int(hex_[1:3], 16), int(hex_[3:5], 16), int(hex_[5:7], 16)


def style(fg=None, bg=None, bold=False):
    s = ""
    if bold:
        s += "\033[1m"
    if fg:
        s += "\033[38;2;%d;%d;%dm" % rgb(fg)
    if bg:
        s += "\033[48;2;%d;%d;%dm" % rgb(bg)
    return s


# ---------------------------------------------------------------- text width


def cwidth(c):
    if unicodedata.combining(c):
        return 0
    return 2 if unicodedata.east_asian_width(c) in "WF" else 1


def width(s):
    return sum(cwidth(c) for c in s)


def fit(s, n, align="left"):
    """Truncate (with …) / pad to exactly n display columns."""
    if n <= 0:
        return ""
    if width(s) > n:
        out, w = "", 0
        for c in s:
            if w + cwidth(c) > n - 1:
                break
            out, w = out + c, w + cwidth(c)
        s = out + "…"
    pad = " " * (n - width(s))
    return pad + s if align == "right" else s + pad


class Line:
    """A line made of styled segments, with a known display width."""

    def __init__(self):
        self.parts, self.w = [], 0

    def add(self, text, fg=None, bg=None, bold=False):
        self.parts.append((text, fg, bg, bold))
        self.w += width(text)
        return self

    def pad_to(self, n, bg=None):
        if self.w < n:
            self.add(" " * (n - self.w), bg=bg)
        return self

    def render(self):
        return "".join(style(fg, bg, bold) + text + RESET for text, fg, bg, bold in self.parts)


# ---------------------------------------------------------------- data


_last_panes = []
# How long the last `wezterm cli list` took (None until the first call, CLI_TIMEOUT_SEC when it timed out).
# A slow answer means the WezTerm GUI main thread is busy, usually a Lua handler that runs too often or does too much
# (format-tab-title once kept it at 100% CPU), so the header warns about it (SLOW_WEZTERM_SEC)
CLI_TIMEOUT_SEC = 5
SLOW_WEZTERM_SEC = 1.0
wezterm_latency = None


def wezterm_panes():
    """All panes. When `wezterm cli list` fails (WezTerm busy for a moment, or a cli whose version differs from
    the running GUI), keep the last list instead of drawing an empty dashboard for one refresh."""
    global _last_panes, wezterm_latency
    started = time.monotonic()
    try:
        result = subprocess.run(
            ["wezterm", "cli", "list", "--format", "json"], capture_output=True, text=True, timeout=CLI_TIMEOUT_SEC
        )
        if result.returncode == 0:
            _last_panes = json.loads(result.stdout)
        wezterm_latency = time.monotonic() - started
    except subprocess.TimeoutExpired:
        wezterm_latency = CLI_TIMEOUT_SEC
    except (OSError, ValueError, subprocess.SubprocessError):
        pass
    return _last_panes


def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def pane_path(pane):
    url = pane.get("cwd") or ""
    return unquote(urlparse(url).path) if url.startswith("file://") else url


def short_path(path):
    path = path.rstrip("/") or "/"
    return "~" + path[len(HOME):] if path == HOME or path.startswith(HOME + "/") else path


_branch_cache = {}


def git_info(path):
    """(repo, branch) for a directory, or None outside git. In a worktree, repo is the original repository."""
    hit = _branch_cache.get(path)
    if hit and time.time() - hit[1] < BRANCH_TTL_SEC:
        return hit[0]
    info = None
    try:
        out = subprocess.run(
            ["git", "-C", path, "rev-parse", "--path-format=absolute", "--git-common-dir", "--abbrev-ref", "HEAD"],
            capture_output=True, text=True, timeout=2,
        ).stdout.split("\n")
        if len(out) >= 2 and out[0]:
            info = (os.path.basename(os.path.dirname(out[0].rstrip("/"))), out[1])
    except (OSError, subprocess.SubprocessError):
        pass
    _branch_cache[path] = (info, time.time())
    return info


def agent_states():
    """pane id -> state of the agent running in that pane."""
    states = {}
    try:
        names = os.listdir(STATE_DIR)
    except OSError:
        return states
    for name in names:
        m = re.fullmatch(r"(\d+)\.json", name)
        if m:
            state = read_json(os.path.join(STATE_DIR, name))
            if state:
                states[int(m[1])] = state
    return states


def tab_agents(tab_pane_ids, states, all_panes):
    """Agents of a tab, in launch order: [(pane, state)]. An agent belongs to the tab that holds its home
    pane, wherever the agent pane is now (hidden workspace, or the tab while shown)."""
    out = []
    for pane_id, state in states.items():
        home = state.get("home")
        if pane_id in all_panes and (home in tab_pane_ids if home is not None else pane_id in tab_pane_ids):
            out.append((all_panes[pane_id], state))
    out.sort(key=lambda r: r[0]["pane_id"])
    return out


def collect():
    """Returns (workspace, envs). envs keep the tab order; each env has its agents in screen order."""
    panes = wezterm_panes()
    all_panes = {p["pane_id"]: p for p in panes}
    states = agent_states()
    me = os.environ.get("WEZTERM_PANE")
    mine = next((p for p in panes if str(p["pane_id"]) == me), None)
    workspace = mine["workspace"] if mine else None
    envs, by_tab = [], {}
    for p in panes:
        if workspace and p["workspace"] != workspace:
            continue
        env = by_tab.get(p["tab_id"])
        if env is None:
            title = TAB_STATE_SUFFIX.sub("", p.get("tab_title") or "")
            env = {"tab_id": p["tab_id"], "panes": [], "agents": [], "title": title}
            env["is_dashboard"] = bool(mine and p["tab_id"] == mine["tab_id"]) or title == DASHBOARD_TITLE
            by_tab[p["tab_id"]] = env
            envs.append(env)
        # An agent shown in its tab is not part of the environment's own layout
        # (one run directly in a pane, without a home, is)
        if (states.get(p["pane_id"]) or {}).get("home") is None:
            env["panes"].append(p)
    envs = [e for e in envs if e["panes"]]
    for env in envs:
        env["agents"] = tab_agents({p["pane_id"] for p in env["panes"]}, states, all_panes)
        env["panes"].sort(key=lambda p: (p["left_col"], p["top_row"], p["pane_id"]))
        # The main pane (nvim) is the top-left one; its directory names the environment
        env["main_pane"] = env["panes"][0]
        env["path"] = pane_path(env["main_pane"])
        # Same name as the WezTerm tab: "<repo>  <branch>" (worktrees show the original repository's name)
        git = None if env["is_dashboard"] else git_info(env["path"])
        env["name"] = git[0] if git else (env["title"] or os.path.basename(env["path"].rstrip("/")) or env["path"])
        env["branch"] = git[1] if git else ""
    # The dashboard tab itself goes last, and only when meta agents run in it
    envs = [e for e in envs if not e["is_dashboard"]] + [e for e in envs if e["is_dashboard"] and e["agents"]]
    return workspace, envs


def quotas():
    rows = []
    try:
        names = sorted(os.listdir(STATE_DIR))
    except OSError:
        return rows
    for name in names:
        if name.startswith("quota-") and name.endswith(".json"):
            data = read_json(os.path.join(STATE_DIR, name))
            if data and isinstance(data.get("windows"), dict):
                rows.append(data)
    return rows


# ---------------------------------------------------------------- formatting


def reset_text(key, ts):
    t = time.localtime(ts)
    if key == "5h":
        return time.strftime("%H:%M", t)
    return f"{t.tm_mon}/{t.tm_mday}({WEEKDAY[t.tm_wday]}) {time.strftime('%H:%M', t)}"


def until(ts):
    sec = int(ts - time.time())
    if sec <= 0:
        return ""
    if sec < 3600:
        return f"あと{sec // 60}分"
    if sec < 86400:
        return f"あと{sec // 3600}時間{sec % 3600 // 60}分"
    return f"あと{sec // 86400}日{sec % 86400 // 3600}時間"


def age(ts):
    if not ts:
        return ""
    sec = int(time.time() - ts)
    if sec < 60:
        return f"{sec}秒前"
    if sec < 3600:
        return f"{sec // 60}分前"
    return f"{sec // 3600}時間前"


def pct_color(pct):
    return PAL["error"] if pct >= 80 else PAL["warn"] if pct >= 60 else PAL["accent_text"]


def env_state(env):
    states = [s.get("state") for _, s in env["agents"]]
    return min(states, key=lambda s: ORDER.get(s, 9)) if states else None


# ---------------------------------------------------------------- widgets


def card(w, title_line, body, selected=False, title_bg=None):
    """A card of width w: a filled panel (no ruled border) one step above the page background.
    The selected card gets an accent edge on the left. title_line / body are Line objects (inner width w-4).
    title_bg paints the title row in a color (the dashboard tab; the agent column leaves it plain)."""
    bg = PAL["card"]
    edge = ("▌", PAL["accent"]) if selected else (" ", None)
    inner = w - 4
    out = []

    def row(line, row_bg=None):
        row_bg = row_bg or bg
        r = Line().add(edge[0], fg=edge[1], bg=row_bg).add(" ", bg=row_bg)
        fill = row_bg
        for text, fg, part_bg, bold in line.parts:
            r.add(text, fg, part_bg or row_bg, bold)
        if line.parts and getattr(line, "fill", False):
            fill = line.parts[-1][2] or row_bg
        r.pad_to(inner + 2, bg=fill)
        r.add("  ", bg=row_bg)
        return r

    out.append(row(title_line, title_bg))
    for line in body:
        out.append(row(line))
    # Bottom padding row (keeps the same height as the old ruled card)
    out.append(row(Line()))
    return out


def meter(pct, n):
    """Usage bar: each filled cell is colored by how far along it is (green -> yellow -> red)."""
    filled = max(0, min(n, round(pct / 100 * n)))
    line = Line()
    for i in range(filled):
        t = i / max(1, n - 1)
        line.add("━", fg=mix(PAL["ok"], PAL["warn"], t * 2) if t < 0.5 else mix(PAL["warn"], PAL["error"], (t - 0.5) * 2))
    return line.add("─" * (n - filled), fg=PAL["surface"])


def quota_card(q, w):
    tool = TOOL_LABEL.get(q.get("tool"), q.get("tool", "?"))
    color = 2 if q.get("tool") == "claude" else 6
    title = Line().add(tool, fg=ink(color), bold=True).add(f"  {q.get('profile', '')}", fg=ink(color))
    inner = w - 4
    body = []
    now = time.time()
    for key, label in (("5h", "5h"), ("week", "w")):
        win = q["windows"].get(key)
        if not win or win.get("pct") is None:
            continue
        resets = win.get("resets_at")
        line = Line().add(fit(label, 6), fg=PAL["muted"])
        if resets and resets < now:
            body.append(line.add("リセット済み", fg=PAL["ok"]))
            body.append(Line())
            continue
        pct = round(win["pct"])
        bar = meter(pct, max(8, inner - 6 - 6))
        for part in bar.parts:
            line.add(*part)
        line.add(fit(f"{pct}%", 6, "right"), fg=pct_color(pct), bold=True)
        body.append(line)
        sub = Line().add(" " * 6)
        if resets:
            sub.add(f"{reset_text(key, resets)}", fg=PAL["fg"]).add(f"   {until(resets)}", fg=PAL["muted"])
        body.append(sub)
    return card(w, title, body, title_bg=deco(color))


def agent_line(num, state, inner, selected):
    bg = PAL["selection"] if selected else None
    st = state.get("state")
    ctx = state.get("ctx_pct")
    tail = f"{ctx}%" if ctx is not None else ""
    line = Line()
    line.fill = selected
    line.add(f" {num} ", fg=ink(num - 1), bg=deco(num - 1), bold=True)
    line.add(" ", bg=bg)
    line.add(fit(TOOL_LABEL.get(state.get("tool"), state.get("tool", "?")), 8), fg=PAL["fg"], bg=bg, bold=True)
    # The state as a colored chip
    st_color = STATE_COLOR.get(st, PAL["muted"])
    line.add(" " + fit(STATE_LABEL.get(st, "?"), 8) + " ", fg=ink_of(st_color), bg=tint(st_color), bold=True)
    line.add(" ", bg=bg)
    rest = inner - line.w - 6 - 8
    line.add(fit(state.get("model") or "", max(0, rest)), fg=PAL["muted"], bg=bg)
    line.add(fit(tail, 6, "right"), fg=pct_color(ctx) if ctx is not None else PAL["muted"], bg=bg)
    line.add(fit(age(state.get("updated_at")), 8, "right"), fg=PAL["muted"], bg=bg)
    return line


# ---------------------------------------------------------------- screen


class Screen:
    def __init__(self):
        self.lines = []  # list of Line
        self.hits = []  # (row, col0, col1, item index)

    def blank(self, n=1):
        for _ in range(n):
            self.lines.append(Line())

    def put(self, line):
        self.lines.append(line)

    def put_cards(self, cards, cols, hit_items=None):
        """cards: list of (list[Line], width). Lays them out in rows of `cols` columns."""
        for start in range(0, len(cards), cols):
            row_cards = cards[start:start + cols]
            height = max(len(c[0]) for c in row_cards)
            top = len(self.lines)
            for i in range(height):
                line = Line().add(" " * MARGIN)
                for j, (lines, w) in enumerate(row_cards):
                    if j:
                        line.add(" " * GAP)
                    # Shorter cards in the row are extended with their panel color so the row lines up
                    piece = lines[i] if i < len(lines) else Line().add(" " * w, bg=PAL["card"])
                    for part in piece.parts:
                        line.add(*part)
                    line.pad_to(MARGIN + sum(c[1] for c in row_cards[: j + 1]) + GAP * j)
                self.lines.append(line)
            # A gap between rows of cards (filled panels would otherwise touch)
            if start + cols < len(cards):
                self.lines.append(Line())
            if hit_items:
                col = MARGIN
                for j, (lines, w) in enumerate(row_cards):
                    for offset, item in hit_items[start + j]:
                        self.hits.append((top + offset, col, col + w, item))
                    col += w + GAP

    def draw(self, rows):
        out = ["\033[H"]
        for line in self.lines[:rows]:
            out.append(line.render() + "\033[K\r\n")
        out.append("\033[J")
        sys.stdout.write("".join(out))
        sys.stdout.flush()


def build_items(envs, flat):
    """Selectable items in navigation order: dicts with kind / key / pane / env / state / num."""
    items, num = [], 0
    if flat:
        agents = [(env, p, s) for env in envs for p, s in env["agents"]]
        agents.sort(key=lambda r: (ORDER.get(r[2].get("state"), 9), -(r[2].get("updated_at") or 0)))
        for env, p, s in agents:
            num += 1
            items.append({"kind": "agent", "key": ("p", p["pane_id"]), "pane": p, "env": env, "state": s, "num": num})
        return items
    for env in envs:
        items.append({"kind": "env", "key": ("t", env["tab_id"]), "pane": env["main_pane"], "env": env})
        for p, s in env["agents"]:
            num += 1
            items.append({"kind": "agent", "key": ("p", p["pane_id"]), "pane": p, "env": env, "state": s, "num": num})
    return items


def banner(text, n):
    """One row of n columns, the background a gradient through the pale decoration hues, text on top."""
    line = Line().add(" " * MARGIN)
    col = 0
    for c in fit(text, n):
        line.add(c, fg=PAL["fg"], bg=gradient(col / max(1, n - 1)), bold=True)
        col += cwidth(c)
    return line


def section(label, i):
    """A section heading with a colored block in front."""
    return Line().add(" " * MARGIN).add("▍", fg=deco(i)).add(f" {label}", fg=PAL["fg"], bold=True)


def layout(workspace, envs, items, cursor, flat):
    cols_total, rows_total = shutil.get_terminal_size((120, 40))
    avail = cols_total - MARGIN * 2
    scr = Screen()
    current = items[cursor] if items else None

    # ---- header
    n_envs = sum(1 for e in envs if not e["is_dashboard"])
    all_states = [s.get("state") for e in envs for _, s in e["agents"]]
    # A banner across the width, painted with a gradient through the scheme's hues
    left = f"   ◆ {workspace or '?'}      作業環境 {n_envs}    エージェント {len(all_states)}"
    right = "    ".join(f"{STATE_LABEL[st]} {all_states.count(st)}" for st in ("waiting", "working", "done"))
    right += f"      {time.strftime('%H:%M:%S')}   "
    text = left + " " * max(1, avail - width(left) - width(right)) + right
    scr.blank()
    for row_text in (" " * avail, text, " " * avail):
        scr.put(banner(row_text, avail))
    scr.blank()
    if wezterm_latency is not None and wezterm_latency >= SLOW_WEZTERM_SEC:
        took = f"{CLI_TIMEOUT_SEC}s 以上" if wezterm_latency >= CLI_TIMEOUT_SEC else f"{wezterm_latency:.1f}s"
        warn = fit(f" ⚠ WezTerm の応答が遅い ({took})  CPU を使い続けていないか確認 (docs/wezterm-workspace-design.md の実装メモ) ", avail)
        scr.put(Line().add(" " * MARGIN).add(warn, fg=ink_of(PAL["error"]), bg=tint(PAL["error"]), bold=True))
        scr.blank()

    # ---- quotas
    qs = quotas()
    if qs:
        scr.put(section("利用制限", 2))
        qcols = max(1, min(len(qs), (avail + GAP) // (CARD_MIN_W + GAP)))
        qw = min(CARD_MAX_W, (avail - GAP * (qcols - 1)) // qcols)
        scr.put_cards([(quota_card(q, qw), qw) for q in qs], qcols)
        scr.blank()

    # ---- environments / agents
    ncols = max(1, (avail + GAP) // (CARD_MIN_W + GAP))
    if flat:
        scr.put(section("エージェント", 0).add("  入力待ちが先頭", fg=PAL["muted"]))
        w = avail
        body, hit = [], []
        for idx, it in enumerate(items):
            line = agent_line(it["num"], it["state"], w - 4 - 18, idx == cursor)
            line.add(fit("  " + it["env"]["name"], 18), fg=PAL["muted"], bg=PAL["selection"] if idx == cursor else None)
            hit.append((len(body) + 1, idx))
            body.append(line)
        if not body:
            body.append(Line().add("エージェントは動いていません", fg=PAL["muted"]))
        scr.put_cards([(card(w, Line().add("全エージェント", fg=PAL["fg"], bold=True), body, True), w)], 1, [hit])
    else:
        scr.put(section("作業環境", 4))
        ncols = max(1, min(ncols, len(envs) or 1))
        w = min(CARD_MAX_W, (avail - GAP * (ncols - 1)) // ncols)
        cards, hits = [], []
        for env_index, env in enumerate(envs):
            env_items = [(i, it) for i, it in enumerate(items) if it["env"] is env]
            selected = current is not None and current["env"] is env
            st = env_state(env)
            # Each environment card gets its own color for the title row
            title = Line().add("● ", fg=ink(env_index))
            name = "一覧タブ" if env["is_dashboard"] else env["name"]
            title.add(fit(name, w - 12) if width(name) > w - 12 else name, fg=ink(env_index), bold=True)
            if env["branch"]:
                title.add("  \ue725 " + fit(env["branch"], max(1, w - 16 - title.w)) if width(env["branch"]) > w - 16 - title.w else "  \ue725 " + env["branch"], fg=ink(env_index))
            if st:
                title.add("   " + STATE_LABEL.get(st, ""), fg=ink(env_index))
            body = []
            sub = Line().add(short_path(env["path"]), fg=PAL["muted"])
            body.append(sub)
            body.append(Line())
            hit = [(0, env_items[0][0]), (1, env_items[0][0])]
            for i, it in env_items[1:]:
                hit.append((len(body) + 1, i))
                body.append(agent_line(it["num"], it["state"], w - 4, i == cursor))
            if len(env_items) == 1:
                body.append(Line().add("エージェントなし  ", fg=PAL["muted"]).add("LEADER c / x で起動", fg=PAL["muted"]))
            cards.append((card(w, title, body, selected, title_bg=deco(env_index)), w))
            hits.append(hit)
        if cards:
            scr.put_cards(cards, ncols, hits)
        else:
            scr.put(Line().add(" " * MARGIN).add("作業環境がありません。Cmd+t か LEADER n で開けます", fg=PAL["muted"]))

    # ---- footer (key hints as pills), pinned to the bottom when there is room
    hints = [("↵", "開く"), ("j k", "移動"), ("h l", "カード"), ("1-9", "エージェントへ"),
             ("a", "カード表示" if flat else "エージェント一覧"), ("クリック", "開く")]
    foot = Line().add(" " * MARGIN)
    for i, (key, label) in enumerate(hints):
        foot.add(f" {key} ", fg=ink(i), bg=deco(i), bold=True).add(f" {label}   ", fg=PAL["muted"])
    while len(scr.lines) < rows_total - 2:
        scr.blank()
    scr.blank()
    scr.put(foot)
    return scr, rows_total


# ---------------------------------------------------------------- input


AGENT_VIEW = os.path.join(os.path.dirname(os.path.realpath(__file__)), "agent-view")


def show_agent(pane_id):
    """Put the agent in the right pane of its tab and focus it (bin/agent-view)."""
    subprocess.run([AGENT_VIEW, "show", str(pane_id)], capture_output=True)


def jump(item):
    """Open an item: an agent is shown in the right pane of its tab, an environment is activated."""
    pane = item["pane"]
    if item["kind"] == "agent":
        show_agent(pane["pane_id"])
        return
    subprocess.run(["wezterm", "cli", "activate-tab", "--tab-id", str(pane["tab_id"])], capture_output=True)
    subprocess.run(["wezterm", "cli", "activate-pane", "--pane-id", str(pane["pane_id"])], capture_output=True)


# ---------------------------------------------------------------- input


def read_input():
    """Returns a key name, or ("click", x, y) for a left click (SGR mouse, 1-based)."""
    data = os.read(sys.stdin.fileno(), 64).decode(errors="ignore")
    m = re.match(r"\033\[<(\d+);(\d+);(\d+)([Mm])", data)
    if m:
        button, x, y, kind = int(m[1]), int(m[2]), int(m[3]), m[4]
        if button == 0 and kind == "M":
            return ("click", x, y)
        if button in (64, 65):
            return "up" if button == 64 else "down"
        return ""
    keys = {"\033[A": "up", "\033[B": "down", "\033[C": "right", "\033[D": "left", "\t": "right", "\033[Z": "left"}
    return keys.get(data, data[:1])


@contextlib.contextmanager
def terminal():
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    tty.setcbreak(fd)
    # alternate screen, hide cursor, mouse (press + SGR coordinates)
    sys.stdout.write("\033[?1049h\033[?25l\033[?1000h\033[?1006h")
    try:
        yield
    finally:
        sys.stdout.write("\033[?1000l\033[?1006l\033[?25h\033[?1049l")
        sys.stdout.flush()
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def main():
    cursor_key, flat = None, False
    with terminal():
        while True:
            refresh_palette()
            workspace, envs = collect()
            items = build_items(envs, flat)
            keys = [it["key"] for it in items]
            cursor = keys.index(cursor_key) if cursor_key in keys else 0
            scr, rows = layout(workspace, envs, items, cursor, flat)
            scr.draw(rows)
            ready, _, _ = select.select([sys.stdin], [], [], REFRESH_SEC)
            if not ready:
                continue
            key = read_input()
            env_starts = [i for i, it in enumerate(items) if it["kind"] == "env"]
            if isinstance(key, tuple):
                _, x, y = key
                for row, c0, c1, idx in scr.hits:
                    if row == y - 1 and c0 <= x - 1 < c1:
                        cursor = idx
                        jump(items[idx])
                        break
            elif key in ("j", "down") and items:
                cursor = min(cursor + 1, len(items) - 1)
            elif key in ("k", "up") and items:
                cursor = max(cursor - 1, 0)
            elif key in ("l", "right") and env_starts:
                cursor = next((i for i in env_starts if i > cursor), env_starts[0])
            elif key in ("h", "left") and env_starts:
                start = max(i for i in env_starts if i <= cursor)
                prev = [i for i in env_starts if i < start]
                cursor = prev[-1] if prev else env_starts[-1]
            elif key in ("\r", "\n") and items:
                jump(items[cursor])
            elif key == "a":
                flat, cursor = not flat, 0
                cursor_key = None
                continue
            elif key.isdigit() and key != "0":
                agents = [it for it in items if it["kind"] == "agent"]
                if int(key) <= len(agents):
                    jump(agents[int(key) - 1])
            cursor_key = keys[cursor] if items and cursor < len(keys) else None


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
