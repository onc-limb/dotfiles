#!/usr/bin/env python3
"""Show an agent in its work environment, or put it away.

The agents of a work environment tab are stacked in columns on the right of the tab, in pane-id order
(the same order as the numbers in the tab bar), where you use them directly (no zoom). While put away
(LEADER z) or before their tab is opened (restored sessions), they wait in a hidden workspace (STASH;
WezTerm shows no window for a workspace that is not active). The width of the column and the equal heights
of the agents follow the main nvim (wezterm/workspace.lua apply_layout).

Each agent's home is the pane it belongs to (the main nvim of the work environment, or the dashboard):
the "home" field of ~/.local/state/agents/<pane>.json, written by wezterm/workspace.lua and bin/agent-state.

Usage:
  agent-view show <pane> [--no-focus]   stack the agent, with every other agent of its home, in the right column
                                        of its home tab and focus it; --no-focus keeps the focus where it is
  agent-view hide <pane>                move the agent back to the hidden workspace and focus its home pane
                                        (the tab stays without it until an agent is shown again)
  agent-view sync <home>                rearrange the agents of a home after its layout changed

Main agents (started by you) and child agents (started by an agent with bin/agent-spawn, which writes
"parent") are kept apart: with no file open in nvim (layout "tree", written to layout-<home> by WezTerm)
the children get their own column right of the main agents; with a file open ("edit") they are put away.
"""
import json
import os
import shutil
import subprocess
import sys
import time

STATE_DIR = os.path.expanduser("~/.local/state/agents")
STASH = "_agents"


def wezterm():
    # WEZTERM_EXECUTABLE is wezterm-gui; the cli is the wezterm next to it.
    # Started from WezTerm's Lua (not from a pane), PATH may not contain wezterm
    gui = os.environ.get("WEZTERM_EXECUTABLE")
    for path in (gui and os.path.join(os.path.dirname(gui), "wezterm"), shutil.which("wezterm"),
                 "/opt/homebrew/bin/wezterm", "/Applications/WezTerm.app/Contents/MacOS/wezterm"):
        if path and os.path.exists(path):
            return path
    return "wezterm"


WEZTERM = wezterm()


def cli(*args):
    return subprocess.run([WEZTERM, "cli", *map(str, args)], capture_output=True, text=True, timeout=5)


def panes():
    # `wezterm cli list` sometimes fails for a moment (WezTerm busy, or a cli whose version differs from the
    # running GUI); retry a few times before giving up, so a key press is not silently ignored
    for attempt in range(3):
        try:
            result = cli("list", "--format", "json")
            if result.returncode == 0:
                return {p["pane_id"]: p for p in json.loads(result.stdout)}
        except (ValueError, subprocess.SubprocessError, OSError):
            pass
        time.sleep(0.1 * (attempt + 1))
    return {}


def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def home_of(pane_id):
    return read_json(os.path.join(STATE_DIR, f"{pane_id}.json")).get("home")


def write_shown(home, pane_id):
    """Remember the last agent shown for a home (LEADER z shows it again) and clear the hidden mark."""
    try:
        with open(os.path.join(STATE_DIR, f"shown-{home}"), "w") as f:
            f.write(str(pane_id))
    except OSError:
        pass
    set_hidden(home, False)


def set_hidden(home, hidden):
    """Mark a tab whose agent was put away with LEADER z, so WezTerm does not show one again by itself."""
    path = os.path.join(STATE_DIR, f"hidden-{home}")
    try:
        if hidden:
            open(path, "w").close()
        else:
            os.remove(path)
    except OSError:
        pass


def focused_pane():
    """The pane the GUI is focused on (to put the focus back after moving panes around)."""
    try:
        result = cli("list-clients", "--format", "json")
        clients = json.loads(result.stdout) if result.returncode == 0 else []
        return clients[0].get("focused_pane_id") if clients else None
    except (ValueError, subprocess.SubprocessError, OSError, IndexError):
        return None


def stash(pane_id):
    cli("move-pane-to-new-tab", "--pane-id", pane_id, "--new-window", "--workspace", STASH)


def layout_of(home):
    """The work environment's layout, written by wezterm/workspace.lua: "tree" (no file open, or Cmd+Shift+a)
    shows the child agents in their own column, "edit" puts them away. Missing: show everything."""
    try:
        with open(os.path.join(STATE_DIR, f"layout-{home}")) as f:
            return f.read().strip() or "tree"
    except OSError:
        return "tree"


def is_hidden(home):
    return os.path.exists(os.path.join(STATE_DIR, f"hidden-{home}"))


def columns_in_tab(ids, all_panes):
    """The agents of `ids` that are in the tab, as columns (left to right) of panes (top to bottom)."""
    by_left = {}
    for p in ids:
        by_left.setdefault(all_panes[p]["left_col"], []).append(p)
    return [sorted(col, key=lambda p: all_panes[p]["top_row"]) for _, col in sorted(by_left.items())]


def common_prefix(have, want):
    n = 0
    while n < len(have) and n < len(want) and have[n] == want[n]:
        n += 1
    return have[:n]


def arrange(home, all_panes, requested=None):
    """Stack the agents of `home` in its tab: the main agents (started by you) in a column right of nvim, and
    the child agents (started by an agent with agent-spawn: "parent" is a live pane) in a second column
    further right. In the "edit" layout the children are put away, except `requested` (shown on demand),
    which goes under the main agents. Columns keep pane-id order; panes already in place are not moved.
    Returns the panes put away."""
    tab = all_panes[home]["tab_id"]
    mine = sorted(p for p in all_panes if p != home and home_of(p) == home)
    kids = [p for p in mine if read_json(os.path.join(STATE_DIR, f"{p}.json")).get("parent") in all_panes]
    mains = [p for p in mine if p not in kids]
    if not mains:
        mains, kids = kids, []
    if layout_of(home) == "tree":
        want = [mains, kids]
    else:
        want = [mains + ([requested] if requested in kids else []), []]
    in_tab = [p for p in mine if all_panes[p]["tab_id"] == tab]
    have = columns_in_tab(in_tab, all_panes)
    keep = [common_prefix(have[0], want[0]) if have else [], []]
    if keep[0] and len(have) > 1:
        keep[1] = common_prefix(have[1], want[1])
    stashed = [p for p in in_tab if p not in keep[0] and p not in keep[1]]
    for p in stashed:
        stash(p)
    # The sizes are set by wezterm/workspace.lua apply_layout
    for i, column in enumerate(keep):
        for p in want[i]:
            if p in column:
                continue
            if column:
                cli("split-pane", "--pane-id", column[-1], "--bottom", "--percent", 50, "--move-pane-id", p)
            elif i == 0:
                cli("split-pane", "--pane-id", home, "--right", "--percent", 40, "--move-pane-id", p)
            else:
                # A full-height column at the right edge of the tab
                cli("split-pane", "--pane-id", home, "--top-level", "--right", "--percent", 30, "--move-pane-id", p)
            column.append(p)
    return stashed


def restore_focus(previous, home, all_panes, stashed):
    """Keep the home pane active in its tab, then go back to the pane the user was on. activate-pane also
    activates the pane's tab, so without this an agent started in the background pulls the user to its tab."""
    alive = previous is not None and previous in all_panes and previous not in stashed
    if not alive or all_panes[previous]["tab_id"] == all_panes[home]["tab_id"]:
        cli("activate-pane", "--pane-id", home)
    if alive and previous != home:
        cli("activate-pane", "--pane-id", previous)


def show(pane_id, focus=True):
    all_panes = panes()
    agent = all_panes.get(pane_id)
    home = home_of(pane_id)
    if not agent:
        return
    if home not in all_panes:
        # Started directly in a pane (no home): it already lives in its own tab, so just go there
        if focus:
            cli("activate-tab", "--tab-id", agent["tab_id"])
            cli("activate-pane", "--pane-id", pane_id)
        return
    tab = all_panes[home]["tab_id"]
    # --no-focus: whatever the user is looking at stays (moving panes changes the active pane of the home tab)
    previous = None if focus else focused_pane()
    stashed = arrange(home, all_panes, requested=pane_id)
    # The pane is used where it is, never zoomed (also undo the zoom of older versions)
    cli("zoom-pane", "--pane-id", pane_id, "--unzoom")
    if focus:
        cli("activate-tab", "--tab-id", tab)
        cli("activate-pane", "--pane-id", pane_id)
    else:
        restore_focus(previous, home, all_panes, stashed)
    write_shown(home, pane_id)


def sync(home):
    """Rearrange the agents of `home` after its layout changed (the focus stays where it is).
    Does nothing while they are put away with LEADER z."""
    all_panes = panes()
    if home not in all_panes or is_hidden(home):
        return
    previous = focused_pane()
    stashed = arrange(home, all_panes)
    restore_focus(previous, home, all_panes, stashed)


def hide(pane_id):
    all_panes = panes()
    agent = all_panes.get(pane_id)
    home = home_of(pane_id)
    if not agent or agent["workspace"] == STASH:
        return
    stash(pane_id)
    if home in all_panes:
        set_hidden(home, True)
        cli("activate-pane", "--pane-id", home)


def main():
    args = sys.argv[1:]
    no_focus = "--no-focus" in args
    args = [a for a in args if a != "--no-focus"]
    if len(args) != 2 or args[0] not in ("show", "hide", "sync") or not args[1].isdigit():
        print(__doc__, file=sys.stderr)
        return 2
    if args[0] == "show":
        show(int(args[1]), focus=not no_focus)
    elif args[0] == "sync":
        sync(int(args[1]))
    else:
        hide(int(args[1]))
    return 0


if __name__ == "__main__":
    sys.exit(main())
