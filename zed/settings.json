// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "ui_font_size": 14.0,
  "terminal": {
    "font_weight": 400.0,
    "font_size": 10.0
  },
  "expand_excerpt_lines": 5,
  "edit_predictions": {
    "mode": "eager"
  },
  "vim": {
    "toggle_relative_line_numbers": true
  },
  "vim_mode": true,
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "diff_view_style": "split",
  "cli_default_open_behavior": "existing_window",
  "git_panel": {
    "tree_view": false,
    "dock": "left"
  },
  "agent": {
    "enable_feedback": false,
    "threads_sidebar": {
      "default_width": 200.0,
      "position": "right"
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "project_panel": {
    "dock": "left"
  },
  "tabs": {
    "git_status": true
  },
  "session": {
    "trust_all_worktrees": true
  },
  "cursor_shape": "bar",
  "cursor_blink": false,
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "mode": "auto",
        "model": "opus"
      },
      "type": "registry"
    },
    "Claude Code (Work)": {
      "type": "custom",
      "command": "/opt/homebrew/bin/npx",
      "args": ["-y", "@agentclientprotocol/claude-agent-acp"],
      "env": {
        "CLAUDE_CONFIG_DIR": "/Users/satoshi-onga/.claude-work",
        "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
      },
      "default_config_options": {
        "mode": "auto",
        "model": "opus"
      }
    }
  },
  "base_keymap": "VSCode",
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "buffer_font_size": 12.0,
  "languages": {
    "HTML": {
      // ASSUMPTION: 「インデント幅は小さめ」を 2 スペースと解釈した
      "tab_size": 2,
      "prettier": {
        "allowed": true,
        // 既定の "css" は inline 要素の空白を意味ありとみなして入れ子を畳むため、
        // 全ての入れ子をインデントさせるには "ignore" にする
        "htmlWhitespaceSensitivity": "ignore",
        "tabWidth": 2,
      },
    },
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Light"
  },
}
